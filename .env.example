# Compte Gmail qui envoie les messages (le plus simple: la boite du comite).
JSEO_MAIL_USER=jseo.metaheuristiques2026@gmail.com

# Mot de passe d'application Google, 16 caracteres, PAS le mot de passe du compte.
# Genere sur https://myaccount.google.com/apppasswords (validation en 2 etapes requise).
JSEO_MAIL_PASS=

# Boite qui recoit les dossiers de soumission.
JSEO_STAFF_EMAIL=jseo.metaheuristiques2026@gmail.com

# Serveur SMTP. Valeurs par defaut adaptees a Gmail.
JSEO_MAIL_HOST=smtp.gmail.com
JSEO_MAIL_PORT=465

# Cloudflare Turnstile. La cle de site est publique et deja dans soumission.html.
# La cle secrete se recupere sur https://dash.cloudflare.com > Turnstile > widget.
TURNSTILE_SECRET_KEY=

# Supabase. L'URL et la cle anon sont aussi servies au navigateur par
# api.tarmacq.com/api/config.js ; elles sont publiques par nature.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# Cle service_role. Contourne la RLS, acces total a la base.
# Serveur uniquement. Ne jamais la mettre dans config.js ni dans une page.
SUPABASE_SERVICE_ROLE_KEY=

# Noms de la table et du bucket, si vous changez ceux du schema.
SUPABASE_TABLE=jseo_submissions
SUPABASE_BUCKET=jseo-resumes
